<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ launch screen, dark mode.

      The brand backdrop is black in both light and dark, so the splash
      attributes are identical to values-v31/. Only the parent theme differs,
      matching the existing values-night/ overlay.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
