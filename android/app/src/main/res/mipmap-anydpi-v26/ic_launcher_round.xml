<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icons are masked by the launcher, so the round variant is identical
  to ic_launcher.xml — the shape comes from the mask, not from the asset. This
  file exists only so `android:roundIcon` resolves to an adaptive icon on API 26+
  instead of falling back to the pre-rendered circular PNG.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
