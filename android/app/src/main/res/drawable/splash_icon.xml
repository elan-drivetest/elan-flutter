<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash icon for the Android 12+ SplashScreen API.

  The platform draws this into a 288dp canvas and masks everything outside the
  inner 192dp circle. That is the same two-thirds proportion the adaptive icon's
  foreground layer is already built to (mark sized against the inner 72 of 108
  dp), so the adaptive foreground can be handed over as-is — no inset, and no
  second copy of the artwork to keep in sync.

  It must NOT be `@mipmap/ic_launcher`: that one is the full-bleed legacy icon,
  which arrives with its own opaque background and gets its edges clipped by the
  mask.

  Referenced from values-v31/ and values-night-v31/, so it is never inflated
  below API 31.
-->
<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@mipmap/ic_launcher_foreground"
    android:gravity="fill" />
